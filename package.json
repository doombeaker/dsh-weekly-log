{
  "name": "dsh-weekly-report",
  "version": "0.1.0",
  "description": "Keep a running list of what you did and plan to do, then turn a week of it into a weekly report with a one-click model polish.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/impl.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/impl.js",
    "prepublishOnly": "npm run check"
  },
  "author": "姚迟",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": ["dsh", "deepseek-harness", "plugin", "weekly-report", "weekly"]
}
